# Backend environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit .env (it is already in .gitignore).

# --- Required ---------------------------------------------------------------
# OpenRouter: used for query embeddings (baai/bge-large-en-v1.5),
# query refinement (openai/gpt-4o-mini) and answer generation (openai/gpt-4o).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Qdrant Cloud: vector database holding the 11,008 paper chunks.
# Get these from https://cloud.qdrant.io (cluster URL + API key)
QDRANT_URL=
QDRANT_API_KEY=

# --- Optional ---------------------------------------------------------------
# Cohere: reranks hybrid-search results (rerank-english-v3.0).
# If left empty, results are returned in hybrid-search order.
# Get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Turn Cohere reranking on/off (default: true)
USE_RERANKER=true

# Qdrant collection name (default: siggraph2025_papers)
COLLECTION_NAME=

# Path to chunks.json, relative to backend/ (default: ./chunks.json)
CHUNKS_PATH=

# Port for the API server (default: 8082; Render sets this automatically)
# PORT=8082

# Note: model names, temperature, max tokens and top_k are set in code
# (GenerationConfig in rag_generate.py, RetrievalPipelineConfig in
# retrieval_pipeline.py), not read from environment variables.
